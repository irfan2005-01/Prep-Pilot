# Prep Pilot Backend Configuration
# Copy this file to .env or export these environment variables before running the backend.

# Port on which the Spring Boot application will listen
SERVER_PORT=8080

# Google Gemini API Key (Required for live AI resume analysis)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma-separated URLs for the React frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SESSION_COOKIE_SECURE=false # Set true when serving over HTTPS in production

# PostgreSQL Persistence Configuration (Phase 5)
# If PostgreSQL is not running locally on port 5432, Prep Pilot automatically
# falls back to an in-memory database with Flyway schema migrations enabled.
DB_URL=jdbc:postgresql://localhost:5432/preppilot
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
