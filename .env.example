# Prep Pilot Root Environment Configuration
# Team: Nexora
# Project: Prep Pilot — "Your co-pilot from resume to offer"

# Backend Settings (Spring Boot + Java 21)
SERVER_PORT=8080
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Persistence Configuration (Phase 5)
DB_URL=jdbc:postgresql://localhost:5432/preppilot
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver

# Frontend Settings (React + Vite)
VITE_API_BASE_URL=http://localhost:8080

